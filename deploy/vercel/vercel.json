{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "core": {
      "root": "core/",
      "entrypoint": "index.mjs",
      "installCommand": "echo skip",
      "buildCommand": "echo skip",
      "functions": {
        "index.mjs": { "maxDuration": 300, "includeFiles": "**" }
      },
      "bindings": [{ "type": "service", "service": "intel", "format": "url", "env": "MUNIM_INTEL_URL" }]
    },
    "intel": {
      "root": "intel/",
      "entrypoint": "index:app",
      "functions": {
        "index.py": { "maxDuration": 300 }
      }
    },
    "suppliers": {
      "root": "suppliers/",
      "entrypoint": "index:app",
      "functions": {
        "index.py": { "maxDuration": 60 }
      }
    }
  },
  "rewrites": [
    { "source": "/suppliers-sim/(.*)", "destination": { "service": "suppliers" } },
    { "source": "/(.*)", "destination": { "service": "core" } }
  ],
  "crons": [{ "path": "/internal/cron/v1/tick", "schedule": "0 1 * * *" }]
}
