{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.graph.supplier",
  "title": "V1GraphSupplier",
  "x-munim-module": "graph",
  "type": "object",
  "properties": {
    "supplier": {
      "type": "object",
      "properties": {
        "supplier_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "simulated": {
          "type": "boolean"
        }
      },
      "required": [
        "supplier_id",
        "name",
        "simulated"
      ],
      "additionalProperties": false,
      "title": "GraphSupplier"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredient_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "only_source": {
            "type": "boolean"
          },
          "other_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "supplier_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "simulated": {
                  "type": "boolean"
                }
              },
              "required": [
                "supplier_id",
                "name",
                "simulated"
              ],
              "additionalProperties": false,
              "title": "GraphSupplier"
            }
          },
          "quoted_by": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "supplier_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "simulated": {
                  "type": "boolean"
                }
              },
              "required": [
                "supplier_id",
                "name",
                "simulated"
              ],
              "additionalProperties": false,
              "title": "GraphSupplier"
            }
          },
          "dishes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "outlets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "outlet_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "available": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "outlet_id",
                      "name",
                      "available"
                    ],
                    "additionalProperties": false,
                    "title": "GraphDishOutlet"
                  }
                }
              },
              "required": [
                "item_id",
                "name",
                "outlets"
              ],
              "additionalProperties": false
            }
          },
          "outlets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "outlet_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "outlet_id",
                "name"
              ],
              "additionalProperties": false,
              "title": "GraphOutlet"
            }
          }
        },
        "required": [
          "ingredient_id",
          "name",
          "only_source",
          "other_sources",
          "quoted_by",
          "dishes",
          "outlets"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "impact_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^⟨snap:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}·(?:0|[1-9][0-9]*)·[a-z_][a-z0-9_]*⟩$"
              },
              {
                "type": "null"
              }
            ]
          },
          "about_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        "required": [
          "finding_id",
          "type",
          "severity",
          "impact_ref",
          "about_ids"
        ],
        "additionalProperties": false,
        "title": "GraphFinding"
      }
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "draft_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "command_type": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)+\\.v[1-9][0-9]*$"
          },
          "about_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        "required": [
          "draft_id",
          "command_type",
          "about_ids"
        ],
        "additionalProperties": false,
        "title": "GraphDraft"
      }
    },
    "graph": {
      "type": "object",
      "properties": {
        "projected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
        }
      },
      "required": [
        "projected_at"
      ],
      "additionalProperties": false,
      "title": "GraphStamp"
    }
  },
  "required": [
    "supplier",
    "ingredients",
    "findings",
    "drafts",
    "graph"
  ],
  "additionalProperties": false
}
