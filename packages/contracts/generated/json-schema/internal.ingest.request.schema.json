{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.ingest.request",
  "title": "InternalIngestRequest",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "application/pdf"
      ]
    },
    "content_base64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 7000000
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "aliases": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "supplier",
              "ingredient"
            ]
          },
          "core_ref": {
            "type": "string",
            "pattern": "^core\\.[a-z_]+:[0-9a-f-]{36}$"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "kind",
          "core_ref",
          "alias"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "document_id",
    "media_type",
    "content_base64",
    "currency",
    "aliases"
  ],
  "additionalProperties": false
}
