{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.imports.market-price.response",
  "title": "V1ImportsMarketPriceResponse",
  "x-munim-module": "imports",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "previewed",
        "no_price",
        "unavailable"
      ]
    },
    "duplicate": {
      "type": "boolean"
    },
    "import_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "draft_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "duplicate",
    "import_run_id",
    "draft_id"
  ],
  "additionalProperties": false
}
