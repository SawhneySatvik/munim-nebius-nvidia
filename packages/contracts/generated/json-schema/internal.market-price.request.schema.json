{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.market-price.request",
  "title": "InternalMarketPriceRequest",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "ingredient": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "on_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
    }
  },
  "required": [
    "ingredient",
    "currency",
    "on_date"
  ],
  "additionalProperties": false
}
