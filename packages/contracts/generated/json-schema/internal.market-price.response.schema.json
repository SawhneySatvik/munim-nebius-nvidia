{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.market-price.response",
  "title": "InternalMarketPriceResponse",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "no_price",
        "unavailable"
      ]
    },
    "csv": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,79}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "run_id",
    "status",
    "csv",
    "origin"
  ],
  "additionalProperties": false
}
