{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.graph.sole-sources",
  "title": "V1GraphSoleSources",
  "x-munim-module": "graph",
  "type": "object",
  "properties": {
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredient_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "supplier_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "simulated": {
                  "type": "boolean"
                }
              },
              "required": [
                "supplier_id",
                "name",
                "simulated"
              ],
              "additionalProperties": false,
              "title": "GraphSupplier"
            }
          }
        },
        "required": [
          "ingredient_id",
          "name",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "graph": {
      "type": "object",
      "properties": {
        "projected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
        }
      },
      "required": [
        "projected_at"
      ],
      "additionalProperties": false,
      "title": "GraphStamp"
    }
  },
  "required": [
    "ingredients",
    "graph"
  ],
  "additionalProperties": false
}
