{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.imports.document-text",
  "title": "V1ImportsDocumentText",
  "x-munim-module": "imports",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "chunks": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "char_start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "char_start",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "document_id",
    "chunks"
  ],
  "additionalProperties": false
}
